# Copiar este archivo a .env (no se versiona) y completar las claves.
# src/config.py (API_KEY_ENV) indica qué variable usa cada proveedor.

# Proveedor por defecto de run_experiment.py: openai | anthropic (opcional)
PROVEEDOR=anthropic

# API keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Modelos (opcional; por defecto los de src/config.py)
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4.1-mini

# Esfuerzo de razonamiento de Claude: low | medium | high | xhigh | max (opcional)
ANTHROPIC_EFFORT=medium
